# SpeechShield backend environment (copy to .env)
APP_NAME=SpeechShield API
APP_VERSION=0.1.0-layer0
DEBUG=false

# CORS
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Model artifacts (private). Keep under backend/artifacts/v4.
ARTIFACT_DIR=artifacts/v4
DEVICE=cpu

# Optional override for checkpoint SHA-256 (leave empty to use manifest)
EXPECTED_CHECKPOINT_SHA256=
