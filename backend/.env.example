# SpeechShield backend environment (copy to .env)
APP_NAME=SpeechShield API
APP_VERSION=0.1.0-layer0
DEBUG=false

# CORS
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Model artifacts (private). Keep under backend/artifacts/v4.
ARTIFACT_DIR=artifacts/v4
DEVICE=cpu

# Optional override for checkpoint SHA-256 (leave empty to use manifest)
EXPECTED_CHECKPOINT_SHA256=

# Database (Layer 3)
DATABASE_URL=sqlite:///./data/speechshield.db

# Authentication (Layer 4) - CHANGE IN PRODUCTION
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=REPLACE_WITH_A_32_BYTE_OR_LONGER_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limiting (Layer 3)
RATE_LIMIT_PER_MINUTE=60
